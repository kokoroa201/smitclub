NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# 알림 이메일(Resend) — 셋 다 있어야 실제 발송된다. 하나라도 비어 있으면
# 사이트 내부 알림(종 아이콘)만 생성되고 이메일은 조용히 건너뛴다.
RESEND_API_KEY=
EMAIL_FROM=
NEXT_PUBLIC_APP_URL=

# 학교 공지·학사일정 자동 동기화(Vercel Cron -> /api/cron/sync-news)를 검증하는
# 값. Vercel 프로젝트 환경변수에 이 값을 넣고, 같은 값을 vercel.json의 크론이
# 호출할 때 Authorization: Bearer 헤더로 보내도록 되어 있다(직접 curl로 호출할
# 때도 이 값이 필요).
CRON_SECRET=
